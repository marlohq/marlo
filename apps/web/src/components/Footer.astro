---
import '@fontsource-variable/inter';
import logom from '@workspace/client/assets/logom.jpg';
---

<div
	class="text-md fixed bottom-0 left-0 right-0 flex flex-wrap items-center justify-start gap-4 px-8 py-6"
>
	<div class="flex flex-1 items-center justify-start gap-3">
		<a href="/">
			<img class="size-7" src={logom.src} alt="marlo logo" />
		</a>
		<span class="hidden flex-1 text-neutral-500 sm:block">©&nbsp;&nbsp;2025</span>
	</div>
	<a href="/manifesto" class="text-neutral-500 hover:text-neutral-800">Manifesto</a>
	<a href="/manifesto#faq" class="text-neutral-500 hover:text-neutral-800">FAQ</a>
	<a href="/legal/terms" class="text-neutral-500 hover:text-neutral-800">Terms</a>
	<a href="/legal/privacy" class="text-neutral-500 hover:text-neutral-800">Privacy</a>
</div>
