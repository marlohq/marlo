---
import { Button } from '@workspace/ui';
import { getCurrentAccountOrThrow } from '../lib/auth.ts';
import { createSetupCheckoutSession } from '../lib/stripe.ts';
import '@workspace/client/styles';

const currentAccount = await getCurrentAccountOrThrow(Astro);

// Check if user needs to set up payment method
const needsPaymentSetup =
	(currentAccount.user.subscriptionData as { status: string } | null)?.status !== 'card_on_file';

// Create checkout session URL if needed
const checkoutUrl = needsPaymentSetup
	? await createSetupCheckoutSession(currentAccount, Astro.url)
	: null;
---

<html lang="en" class="bg-[#FAFAFA]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Account Inactive - Marlo</title>
		<script>
			import { logoutAndRedirect } from '@workspace/client/logout';

			document.querySelector('#logout-form')?.addEventListener('submit', (e: Event) => {
				e.preventDefault();
				logoutAndRedirect();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'l') {
					e.preventDefault();
					logoutAndRedirect();
				}
			});
		</script>
	</head>
	<body class="min-h-screen bg-[#FAFAFA]">
		<header
			class="relative flex w-full items-center justify-between gap-4 px-4 py-2 sm:px-10 sm:py-4"
