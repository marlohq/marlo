---
import '@fontsource-variable/inter';
import Logo from '../components/Logo.astro';
import favicon from '../images/favicon.webp';
import '@workspace/client/styles';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Marlo - Your inbox, reimagined.</title>
		<link rel="shortcut icon" href={favicon.src} />
		<link rel="icon" href={favicon.src} type="image/webp" sizes="32x32" />
		<meta name="robots" content="noindex" />
	</head>
	<body class="bg-[#FAFAFA]">
		<div class="relative">
			<div
				class="from-28% absolute inset-2 bottom-0 rounded-[20px] bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-[#fff1be] via-[#ee87cb] via-70% to-[#b060ff] ring-1 ring-inset ring-black/5 sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))]"
			>
			</div><div class="relative px-6 lg:px-8">
				<div class="mx-auto max-w-3xl lg:max-w-7xl">
					<header class="pt-12 sm:pt-16" data-headlessui-state="">
						<div class="">
							<div
								class="group/row relative isolate flex justify-between pt-[calc(--spacing(2)+1px)] last:pb-[calc(--spacing(2)+1px)]"
							>
								<div
									aria-hidden="true"
									class="absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2"
								>
									<div class="absolute inset-x-0 top-0 border-t border-black/5"></div><div
										class="absolute inset-x-0 top-2 border-t border-black/5"
									>
									</div><div
										class="absolute inset-x-0 bottom-0 hidden border-b border-black/5 group-last/row:block"
									>
									</div><div
										class="absolute inset-x-0 bottom-2 hidden border-b border-black/5 group-last/row:block"
									>
									</div>
								</div><div class="relative flex gap-6">
									<div class="group/item relative py-3">
										<a title="Home" data-headlessui-state="" href="/">
											<Logo width={72} height={36} />
										</a>
									</div>
								</div><nav class="relative hidden lg:flex">
									<div class="group/item relative flex">
										<a
											href="/auth/google/authorize?stage=login"
											class="flex items-center px-4 py-3 text-base font-medium text-gray-950 bg-blend-multiply hover:bg-neutral-900/[5%]"
										>
											Sign in with Google
										</a>
									</div>
								</nav><button
									class="data-hover:bg-black/5 flex size-12 items-center justify-center self-center rounded-lg lg:hidden"
									aria-label="Open main menu"
									id="headlessui-disclosure-button-:Rsm6fkq:"
									type="button"
									aria-expanded="false"
									data-headlessui-state=""
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="currentColor"
										aria-hidden="true"
										data-slot="icon"
										class="size-6"
									>
										<path
											fill-rule="evenodd"
											d="M3 9a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 9Zm0 6.75a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z"
											clip-rule="evenodd"
										>
										</path>
									</svg>
								</button>
							</div>
						</div>
					</header><div
						class="flex flex-col items-center justify-center gap-12 py-16 leading-tight sm:pt-24"
					>
						<h1
							class="font-display text-balance text-[48px] font-semibold tracking-tight text-gray-950 sm:text-[48px] md:text-[64px]"
						>
							Your inbox, reimagined.
						</h1>
						<div class="w-full">
							<img
								alt=""
								src="/screenshot.png"
								class="h-full max-w-[960px] rounded-xl shadow-2xl ring-1 ring-black/10 sm:max-w-[1240px] md:max-w-full xl:-mb-64"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="xl:h-[260px]"></div>

		<div class="py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="mx-auto grid max-w-2xl grid-cols-1 gap-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-5"
				>
					<h2
						class="col-span-2 text-pretty text-4xl font-semibold leading-tight tracking-tight text-gray-900 sm:text-5xl"
					>
						Not just another email client.
					</h2>
					<p
						class="col-span-3 text-pretty text-2xl font-semibold leading-tight tracking-tight text-gray-900 sm:text-3xl"
					>
						We rebuilt the inbox from the ground up to make you brilliant at what you do. Marlo is
						gorgeous and blazingly fast to use. Featuring advanced Keyboard Shortcuts, Instant Send,
						Undo, Scheduled Messages, and more.
					</p>
				</div>
			</div>
		</div>

		<div class="py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="mx-auto grid max-w-2xl grid-cols-1 items-center gap-8 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-5"
				>
					<div class="col-span-2">
						<h2
							class="text-pretty text-4xl font-semibold leading-tight tracking-tight text-gray-900 sm:text-5xl"
						>
							Committed to your data privacy.
						</h2>
						<p class="mt-6 max-w-xl text-lg/8 leading-snug text-gray-700">
							When you sign in with Google, Marlo will request the following permission to your
							account. This access is necessary to provide you with the best email client experience
							possible. You can choose to revoke these permissions at any time.
						</p>
						<p class="mt-6 max-w-xl text-lg/8 leading-snug text-gray-700">
							<a
								href="/legal/privacy"
								class="inline-flex items-center rounded-lg bg-indigo-600 px-8 py-4 text-lg font-semibold text-white shadow-md transition-colors hover:bg-indigo-700 hover:shadow-lg"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="mr-2 h-6 w-6"
									fill="none"
									viewBox="0 0 24 24"
									aria-hidden="true"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
									>
									</path>
								</svg>
								Read Our Privacy Policy
							</a>
						</p>
					</div>
					<div class="col-span-3 flex flex-col gap-8 sm:gap-2 md:flex-row">
						<div class="relative pl-9">
							<dt class="font-semibold">
								<svg
									class="absolute left-1 top-1 size-5 text-indigo-500"
									viewBox="0 0 20 20"
									fill="currentColor"
									aria-hidden="true"
									data-slot="icon"
								>
									<path
										fill-rule="evenodd"
										d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
										clip-rule="evenodd"
									>
									</path>
								</svg>
								Basic Information
							</dt>
							<dd class="">Your name, email, language preferences, and profile picture.</dd>
						</div>
						<div class="relative pl-9">
							<dt class="font-semibold">
								<svg
									class="absolute left-1 top-1 size-5 text-indigo-500"
									viewBox="0 0 20 20"
									fill="currentColor"
									aria-hidden="true"
									data-slot="icon"
								>
									<path
										fill-rule="evenodd"
										d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
										clip-rule="evenodd"
									>
									</path>
								</svg>
								Email
							</dt>
							<dd class="">All email messages including your drafts, attachments and settings.</dd>
						</div>
						<div class="relative pl-9">
							<dt class="font-semibold">
								<svg
									class="absolute left-1 top-1 size-5 text-indigo-500"
									viewBox="0 0 20 20"
									fill="currentColor"
									aria-hidden="true"
									data-slot="icon"
								>
									<path
										fill-rule="evenodd"
										d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
										clip-rule="evenodd"
									>
									</path>
								</svg>
								Contacts
							</dt>
							<dd class="">View your email contacts, including name and email.</dd>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="flex h-svh items-center justify-center">
			<div class="flex flex-col">
				<div class="flex flex-col items-center gap-1">
					<div class="p-6 text-4xl">
						<Logo />
					</div>
					<div class="flex items-center gap-1 self-center justify-self-start text-sm text-gray-500">
						<span>Your inbox, reimagined.</span>
					</div>
					<div class="flex items-center gap-1 self-center justify-self-start text-sm text-gray-500">
						<span>Made with ❤️</span>
						<span>
							from the creators of <a href="https://astro.build/" class="underline" target="_blank">
								Astro
							</a>
						</span>
					</div>
					<div class="flex items-center gap-3 self-center justify-self-start">
						<a href="/legal/privacy" class="text-sm text-gray-500 underline">Privacy Policy</a>
						<a href="/legal/terms" class="text-sm text-gray-500 underline">Terms of Service</a>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
